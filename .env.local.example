# Portão de acesso por senha compartilhada (opcional).
# Copie este arquivo para .env.local para testar localmente (nunca commitar .env.local).
# Em produção, defina estas variáveis em Vercel > Project Settings > Environment Variables
# e faça um redeploy para aplicar.

# "true" ativa o bloqueio por senha; qualquer outro valor (ou ausente) deixa o app aberto.
NEXT_PUBLIC_ACCESS_ENABLED=false

# Senha compartilhada exigida na tela de bloqueio.
NEXT_PUBLIC_ACCESS_PASSWORD=

# Mude este valor (ex: 1 -> 2) e faça redeploy para forçar todo mundo a digitar a senha de novo,
# mesmo sem trocar a senha.
NEXT_PUBLIC_ACCESS_VERSION=1

# URL pública das funções Vercel que fazem OAuth e consultam tarifas do Mercado Livre.
NEXT_PUBLIC_MERCADOLIVRE_API_BASE_URL=https://calculadora.memoriaapps.site

# Backend: configurar apenas no Vercel/ambiente server-side, nunca no frontend.
# MERCADOLIVRE_CLIENT_ID=8689029136462184
# MERCADOLIVRE_CLIENT_SECRET=
# MERCADOLIVRE_REDIRECT_URI=https://calculadora.memoriaapps.site/api/mercadolivre/callback
# MERCADOLIVRE_FRONTEND_ORIGIN=https://SEU-DOMINIO-VERCEL
# MERCADOLIVRE_SITE_ID=MLB
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
